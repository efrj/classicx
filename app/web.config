<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<system.webServer>
		<rewrite>
			<rules>
				<!-- Ignore physical files and application directories -->
				<rule name="PhysicalFiles" stopProcessing="true">
					<match url="^(App|Content|MVC)/.*$" ignoreCase="true" />
					<action type="None" />
				</rule>

				<!-- Home / Feed -->
				<rule name="Home" stopProcessing="true">
					<match url="^home/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Home/HomeController.asp?_A=Index" appendQueryString="true" />
				</rule>

				<!-- Explore / Search -->
				<rule name="Explore" stopProcessing="true">
					<match url="^explore/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Home/HomeController.asp?_A=Explore" appendQueryString="true" />
				</rule>

				<!-- Notifications -->
				<rule name="NotificationsRead" stopProcessing="true">
					<match url="^notifications/read/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Notifications/NotificationsController.asp?_A=ReadPost" appendQueryString="true" />
				</rule>
				<rule name="Notifications" stopProcessing="true">
					<match url="^notifications/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Notifications/NotificationsController.asp?_A=Index" appendQueryString="true" />
				</rule>

				<!-- Bookmarks -->
				<rule name="Bookmarks" stopProcessing="true">
					<match url="^bookmarks/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Tweets/TweetsController.asp?_A=Bookmarks" appendQueryString="true" />
				</rule>

				<!-- Auth routes -->
				<rule name="LoginPost" stopProcessing="true">
					<match url="^login/post/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Auth/AuthController.asp?_A=LoginPost" appendQueryString="true" />
				</rule>
				<rule name="Login" stopProcessing="true">
					<match url="^login/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Auth/AuthController.asp?_A=Login" appendQueryString="true" />
				</rule>
				<rule name="RegisterPost" stopProcessing="true">
					<match url="^register/post/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Auth/AuthController.asp?_A=RegisterPost" appendQueryString="true" />
				</rule>
				<rule name="Register" stopProcessing="true">
					<match url="^(register|signup)/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Auth/AuthController.asp?_A=Register" appendQueryString="true" />
				</rule>
				<rule name="ForgotPost" stopProcessing="true">
					<match url="^forgot/post/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Auth/AuthController.asp?_A=ForgotPost" appendQueryString="true" />
				</rule>
				<rule name="Forgot" stopProcessing="true">
					<match url="^forgot/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Auth/AuthController.asp?_A=Forgot" appendQueryString="true" />
				</rule>
				<rule name="Logout" stopProcessing="true">
					<match url="^logout/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Auth/AuthController.asp?_A=Logout" appendQueryString="true" />
				</rule>
				<rule name="SwitchAccount" stopProcessing="true">
					<match url="^switch-account/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Auth/AuthController.asp?_A=SwitchAccount" appendQueryString="true" />
				</rule>

				<!-- Tweets Actions (POST) -->
				<rule name="TweetCreate" stopProcessing="true">
					<match url="^tweets/create/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Tweets/TweetsController.asp?_A=CreatePost" appendQueryString="true" />
				</rule>
				<rule name="TweetUpload" stopProcessing="true">
					<match url="^tweets/upload/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Tweets/TweetsController.asp?_A=UploadMedia" appendQueryString="true" />
				</rule>
				<rule name="RustFsUploads" stopProcessing="true">
					<match url="^uploads/(.+)$" ignoreCase="true" />
					<action type="Redirect" url="http://localhost:9000/uploads/{R:1}" redirectType="Found" />
				</rule>
				<rule name="TweetDelete" stopProcessing="true">
					<match url="^tweets/delete/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Tweets/TweetsController.asp?_A=DeletePost" appendQueryString="true" />
				</rule>
				<rule name="TweetLike" stopProcessing="true">
					<match url="^tweets/like/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Tweets/TweetsController.asp?_A=LikePost" appendQueryString="true" />
				</rule>
				<rule name="TweetRetweet" stopProcessing="true">
					<match url="^tweets/retweet/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Tweets/TweetsController.asp?_A=RetweetPost" appendQueryString="true" />
				</rule>
				<rule name="TweetBookmark" stopProcessing="true">
					<match url="^tweets/bookmark/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Tweets/TweetsController.asp?_A=BookmarkPost" appendQueryString="true" />
				</rule>

				<!-- Tweet / Status Detail -->
				<rule name="TweetDetail" stopProcessing="true">
					<match url="^(tweet|status|i/status)/([0-9]+)/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Tweets/TweetsController.asp?_A=Show&amp;id={R:2}" appendQueryString="true" />
				</rule>
				<rule name="UserStatusDetail" stopProcessing="true">
					<match url="^@?([a-zA-Z0-9_]+)/status/([0-9]+)/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Tweets/TweetsController.asp?_A=Show&amp;id={R:2}" appendQueryString="true" />
				</rule>

				<!-- Users Actions (POST) -->
				<rule name="UserFollow" stopProcessing="true">
					<match url="^users/follow/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Users/UsersController.asp?_A=FollowPost" appendQueryString="true" />
				</rule>
				<rule name="UserUnfollow" stopProcessing="true">
					<match url="^users/unfollow/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Users/UsersController.asp?_A=UnfollowPost" appendQueryString="true" />
				</rule>
				<rule name="UserUpdateProfile" stopProcessing="true">
					<match url="^users/update-profile/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Users/UsersController.asp?_A=UpdateProfilePost" appendQueryString="true" />
				</rule>

				<!-- User Profile & Lists with @ handle -->
				<rule name="UserFollowersAt" stopProcessing="true">
					<match url="^@([a-zA-Z0-9_]+)/followers/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Users/UsersController.asp?_A=Followers&amp;handle={R:1}" appendQueryString="true" />
				</rule>
				<rule name="UserFollowingAt" stopProcessing="true">
					<match url="^@([a-zA-Z0-9_]+)/following/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Users/UsersController.asp?_A=Following&amp;handle={R:1}" appendQueryString="true" />
				</rule>
				<rule name="UserProfileAt" stopProcessing="true">
					<match url="^@([a-zA-Z0-9_]+)/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Users/UsersController.asp?_A=Profile&amp;handle={R:1}" appendQueryString="true" />
				</rule>

				<!-- User Profile & Lists with user/ or u/ prefix -->
				<rule name="UserFollowersPrefix" stopProcessing="true">
					<match url="^(user|u)/([a-zA-Z0-9_]+)/followers/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Users/UsersController.asp?_A=Followers&amp;handle={R:2}" appendQueryString="true" />
				</rule>
				<rule name="UserFollowingPrefix" stopProcessing="true">
					<match url="^(user|u)/([a-zA-Z0-9_]+)/following/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Users/UsersController.asp?_A=Following&amp;handle={R:2}" appendQueryString="true" />
				</rule>
				<rule name="UserProfilePrefix" stopProcessing="true">
					<match url="^(user|u)/([a-zA-Z0-9_]+)/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Users/UsersController.asp?_A=Profile&amp;handle={R:2}" appendQueryString="true" />
				</rule>

				<!-- User Profile & Lists direct handle fallback (e.g. /classicx) -->
				<rule name="UserFollowersDirect" stopProcessing="true">
					<match url="^([a-zA-Z0-9_]+)/followers/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Users/UsersController.asp?_A=Followers&amp;handle={R:1}" appendQueryString="true" />
				</rule>
				<rule name="UserFollowingDirect" stopProcessing="true">
					<match url="^([a-zA-Z0-9_]+)/following/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Users/UsersController.asp?_A=Following&amp;handle={R:1}" appendQueryString="true" />
				</rule>
				<rule name="UserProfileDirect" stopProcessing="true">
					<match url="^([a-zA-Z0-9_]+)/?$" ignoreCase="true" />
					<action type="Rewrite" url="/App/Controllers/Users/UsersController.asp?_A=Profile&amp;handle={R:1}" appendQueryString="true" />
				</rule>
			</rules>
		</rewrite>
	</system.webServer>
</configuration>
