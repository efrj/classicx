# Copie este arquivo para infra/.env antes de publicar.
# O Docker Compose lê infra/.env automaticamente.
# Sem esse arquivo, os valores abaixo mantêm o ambiente local.

# Site. A porta interna do container continua 80.
HTTP_BIND=0.0.0.0
HTTP_PORT=8000

# MariaDB publicado no host.
# No VPS, use DB_BIND=127.0.0.1 para deixar a porta só na máquina.
# MYSQL_* criam o usuário apenas na primeira inicialização de infra/dbdata.
# Um volume que já existe não troca de senha sozinho.
DB_BIND=0.0.0.0
DB_PORT=3306
MYSQL_DATABASE=bd_classicx
MYSQL_USER=classicx
MYSQL_PASSWORD=classicx
MYSQL_ROOT_PASSWORD=classicx

# Conexão que o Classic ASP abre dentro da rede Docker.
# Mantenha estes valores iguais aos MYSQL_* acima.
# Senha, usuário, host e banco não podem conter ';' nem quebra de linha.
CLASSICX_DB_HOST=db
CLASSICX_DB_PORT=3306
CLASSICX_DB_NAME=bd_classicx
CLASSICX_DB_USER=classicx
CLASSICX_DB_PASSWORD=classicx

# RustFS. A URL interna é usada pelo container web.
# A URL pública é a que o navegador usa para abrir as imagens.
# Exemplo no VPS: http://SEU_IP:9000
# Esse endereço precisa responder o RustFS. Se ele for o próprio ClassicX,
# /uploads volta para a aplicação e o redirecionamento se repete.
RUSTFS_BIND=0.0.0.0
RUSTFS_PORT=9000
RUSTFS_CONSOLE_BIND=0.0.0.0
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
CLASSICX_RUSTFS_INTERNAL_URL=http://rustfs:9000
CLASSICX_RUSTFS_PUBLIC_URL=http://localhost:9000
CLASSICX_RUSTFS_BUCKET=uploads

# Opcional. Os testes e o init_rustfs.py também leem este arquivo.
# CLASSICX_URL=http://localhost:8000
# CLASSICX_RUSTFS_INIT_HOST=127.0.0.1:9000
